# --- Server ----------------------------------------------------------
PORT=4500
# Required to authenticate requests from the web app (the
# /admin/archetype-miner/ocr page). Generate a random value (e.g.
# `openssl rand -hex 32`) and set the SAME value as VISION_OCR_SHARED_SECRET
# in the web app's env file. If left unset, this service accepts requests
# from anyone who can reach it on the network -- only acceptable for quick
# local experimentation, never in docker-compose or production.
VISION_OCR_SHARED_SECRET=

# --- Google Document AI (Image-to-Text/Vision stage) ------------------
# Requires a Google Cloud project with the Document AI API enabled, billing
# set up, and a processor created (Cloud Console -> Document AI -> Create
# Processor -> "Document OCR" -- the general-purpose one works for this;
# note its Processor ID and the region/location you created it in, e.g.
# "us"), plus a service account (IAM & Admin -> Service Accounts -> Create)
# granted the "Document AI API User" role, with a JSON key generated for
# it. Chosen specifically for its strong Devanagari/Hindi OCR support.
GOOGLE_DOCUMENT_AI_PROJECT_ID=your-gcp-project-id
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-processor-id
# From the downloaded service account JSON key file's own client_email field.
GOOGLE_DOCUMENT_AI_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# From the same JSON key file's private_key field -- paste it exactly as it
# appears in that file (a single line with literal \n sequences in it, not
# real line breaks); this service converts those back to real newlines
# itself.
GOOGLE_DOCUMENT_AI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Server ----------------------------------------------------------
PORT=4200
# Required -- unlike the orchestrator/observability services, this one
# refuses to start at all without it (see server.ts). This service handles
# real payments and free-access coupon codes, so "accepts unauthenticated
# requests from anyone who can reach it" is not an acceptable default here
# the way it is for chat/analytics traffic. Generate a random value (e.g.
# `openssl rand -hex 32`) and set the SAME value as PAYMENT_SHARED_SECRET in
# the web app's root .env.local.
PAYMENT_SHARED_SECRET=

# --- Supabase ----------------------------------------------------------
# Same Supabase project as the web app/orchestrator/observability (Project
# Settings -> API). Used to read/write subscriptions and coupon_codes -- the
# service-role key is required since neither table has a client-facing
# write policy for these operations.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- CCAvenue --------------------------------------------------------------
# CCAvenue dashboard -> Business Settings -> API Keys.
CCAVENUE_MERCHANT_ID=your-ccavenue-merchant-id
CCAVENUE_ACCESS_CODE=your-ccavenue-access-code
CCAVENUE_WORKING_KEY=your-ccavenue-working-key
# "test" uses CCAvenue's sandbox (test.ccavenue.com); switch to "production"
# only once you're using live merchant credentials.
CCAVENUE_ENV=test

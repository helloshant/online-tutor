# --- Server ----------------------------------------------------------
PORT=4100
# Required to authenticate requests from the orchestrator. Generate a random
# value (e.g. `openssl rand -hex 32`) and set the SAME value as
# OBSERVABILITY_SHARED_SECRET in the orchestrator's env file. If left unset,
# this service accepts requests from anyone who can reach it on the network --
# only acceptable for quick local experimentation, never in docker-compose or
# production.
OBSERVABILITY_SHARED_SECRET=

# --- Supabase ----------------------------------------------------------
# Same Supabase project as the web app and orchestrator (Project Settings ->
# API). Used only to write to the chat_events table -- the service-role key
# is required since that table's RLS has no client-facing insert policy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM pricing ---------------------------------------------------------
# Cost is computed from token counts using built-in Anthropic pricing
# (USD per million tokens, as of the rates published at
# platform.claude.com/docs/en/pricing). Azure OpenAI has no built-in default
# -- its pricing varies by region/agreement -- so cost stays unrecorded
# (token counts are still recorded) until you set it here.
#
# Optional JSON override, keyed by "provider:model" -> {"inputPerMTok":
# number, "outputPerMTok": number}. Use this to update an Anthropic rate
# that's changed, add Azure OpenAI pricing for your deployment, or reflect a
# promotional/negotiated rate. Example:
# LLM_PRICING_JSON={"azure-openai:gpt-4o":{"inputPerMTok":2.5,"outputPerMTok":10},"anthropic:claude-sonnet-5":{"inputPerMTok":2,"outputPerMTok":10}}
LLM_PRICING_JSON=

# --- Server ----------------------------------------------------------
PORT=4300
# Required -- this service refuses to start without it (see server.ts),
# same posture as PAYMENT_SHARED_SECRET: it fans out who a broadcast
# reaches and records test scores, so "accepts unauthenticated requests
# from anyone who can reach it" is not an acceptable default. Generate a
# random value (e.g. `openssl rand -hex 32`) and set the SAME value as
# BROADCAST_SHARED_SECRET in the web app's root .env.local.
BROADCAST_SHARED_SECRET=

# --- Supabase ----------------------------------------------------------
# Same Supabase project as the web app/orchestrator/observability/payment
# (Project Settings -> API). Used to read/write broadcasts,
# broadcast_recipients, broadcast_feedback_responses, test_questions,
# test_attempts, and test_answers -- the service-role key is required
# since none of those tables has a client-facing RLS policy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

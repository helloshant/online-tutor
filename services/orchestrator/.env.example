# --- Server ----------------------------------------------------------
PORT=4000
# Required to authenticate requests from the web app. Generate a random
# value (e.g. `openssl rand -hex 32`) and set the SAME value as
# ORCHESTRATOR_SHARED_SECRET in the web app's env file. If left unset, this
# service accepts requests from anyone who can reach it on the network --
# only acceptable for quick local experimentation, never in docker-compose
# or production.
ORCHESTRATOR_SHARED_SECRET=

# --- Answer pipeline (cache + knowledge base) -----------------------------
# Every student question first passes a syllabus scope check, then checks
# Redis (exact/near-exact match), then a Postgres full-text answer bank,
# before ever reaching the LLM. Redis is optional in the sense that it fails
# open (caching just gets skipped) if REDIS_URL is unset or unreachable --
# but the pipeline is far slower and more expensive without it.
#
# Running via `docker compose up`: leave this as-is, docker-compose.yml
# overrides it to the in-network hostname (redis://redis:6379).
# Running directly with `npm run dev` against a locally installed Redis:
# redis://localhost:6379.
REDIS_URL=redis://redis:6379
# Optional: how long a cached answer stays valid, in seconds. Defaults to 7
# days if unset.
CACHE_TTL_SECONDS=604800

# This service needs its own read access to Supabase to query/populate the
# Postgres full-text answer bank (the `answered_questions` table) -- it
# never has write access to anything else, and RLS on that table has no
# client-facing policies, so the service-role key is required (the anon key
# won't work here).
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Observability ---------------------------------------------------------
# After every /v1/chat request, this service reports the outcome (cache hit,
# database hit, LLM call with token counts, or a syllabus-gate rejection) to
# the separate observability service, for the admin dashboards at
# /admin/observability. Optional in the sense that it fails open -- if unset,
# events are simply not recorded, the chat pipeline is unaffected.
#
# Running via `docker compose up`: leave this as-is, docker-compose.yml
# overrides it to the in-network hostname (http://observability:4100).
# Running directly with `npm run dev` against a locally running observability
# service (`npm run dev` inside services/observability): http://localhost:4100.
OBSERVABILITY_URL=http://observability:4100
# Must match OBSERVABILITY_SHARED_SECRET in services/observability/.env.local.
OBSERVABILITY_SHARED_SECRET=

# --- LLM provider ---------------------------------------------------------
# Which backend powers the tutor chat: "anthropic" (default) or
# "azure-openai". Only the section for whichever provider you choose needs
# real values below.
LLM_PROVIDER=anthropic

# --- Model tiers (see llm.ts's own LlmTier comment) -------------------------
# Every LLM call picks one of three tiers, matched to its stakes/volume:
#   flagship -- chat tutoring, exercise-attempt grading, practice-paper
#     vision grading. Never the place to cut cost.
#   standard -- exercise/practice-paper generation, topic summaries. The
#     highest-volume tier (up to 41 calls for one practice paper).
#   economy  -- the answer-bank restatement rewrite, the admin chapter-notes
#     emphasis pass. Never shown directly to the student who triggered it.
# All six vars below are optional overrides -- each tier has a working
# default (see llm.ts) and doesn't need to be set at all.

# --- Anthropic (Claude) -------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model ids are stable, portable strings -- tiering works immediately here
# with no extra setup. Defaults: claude-opus-5 / claude-sonnet-5 /
# claude-haiku-4-5 (all already priced in services/observability/src/pricing.ts).
ANTHROPIC_MODEL_FLAGSHIP=
ANTHROPIC_MODEL_STANDARD=
ANTHROPIC_MODEL_ECONOMY=

# --- Azure OpenAI (used only when LLM_PROVIDER=azure-openai) ---------------
# Azure Portal -> your Azure OpenAI resource -> Keys and Endpoint.
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Azure bills/routes per DEPLOYMENT (a name YOU chose in the Azure Portal),
# not a portable model id -- there's no universal "standard" deployment name
# to default to the way Anthropic's model ids allow. All three tiers default
# to this one deployment (gpt-4o) if left unset, so tiering is a genuine
# no-op on Azure -- every tier resolves to the same place -- until you
# provision real additional deployments (e.g. a cheaper gpt-4o-mini for
# ECONOMY) and set these to point at them.
AZURE_OPENAI_DEPLOYMENT_FLAGSHIP=gpt-4o
AZURE_OPENAI_DEPLOYMENT_STANDARD=gpt-4o
AZURE_OPENAI_DEPLOYMENT_ECONOMY=gpt-4o

# --- Chapter notes RAG (semantic retrieval) --------------------------------
# Anthropic has no first-party embedding model -- Voyage AI is Anthropic's
# own recommended embeddings partner, and the only embeddings provider this
# app calls. Used two ways: embedding an admin's chapter document into
# chapter_document_chunks when it's saved (POST /v1/chapter-documents/embed,
# called by the web app's admin Chapter Notes page), and embedding a
# student's live chat question to search those chunks by meaning (stage 4
# of /v1/chat, see chapterRag.ts). Optional in the sense that it fails open
# -- if unset, chapter documents still save (just without ever being
# retrievable), and chat still works (just without this reference material
# woven in) -- but the whole feature is a no-op without it.
# Sign up at voyageai.com to get a key.
VOYAGE_API_KEY=your-voyage-api-key

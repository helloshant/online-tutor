# --- Server ----------------------------------------------------------
PORT=4400
# Required to authenticate requests from the web app (admin actions that
# submit a pipeline run or resolve a review-queue item). Generate a random
# value (e.g. `openssl rand -hex 32`) and set the SAME value as
# ARCHETYPE_MINER_SHARED_SECRET in the web app's env file. If left unset,
# this service accepts requests from anyone who can reach it on the
# network -- only acceptable for quick local experimentation, never in
# docker-compose or production.
ARCHETYPE_MINER_SHARED_SECRET=

# --- Supabase ----------------------------------------------------------
# Same Supabase project as the web app/orchestrator/observability (Project
# Settings -> API). This service reads/writes archetype_* tables
# exclusively (see supabase/migrations/0038_archetype_miner.sql) -- RLS on
# all of them has no client-facing insert policy, so the service-role key
# is required.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM provider ---------------------------------------------------------
# Which backend runs Stages 0/1/2/3 (Segmenter/Analyzer/Miner/Critic):
# "anthropic" (default) or "azure-openai". Only the section for whichever
# provider you choose needs real values below. Independent of the
# orchestrator's own LLM_PROVIDER -- you can mine archetypes on a different
# provider/model than the one answering live student chat.
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) -------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
# Every pipeline stage here reasons over long, structured JSON (a whole
# cluster of questions for Stage 2, the full candidate catalogue for Stage
# 3) -- defaults to Anthropic's current flagship model, not a cheaper one,
# since Stage 3 in particular is explicitly supposed to "critically
# challenge the candidate catalogue" rather than rubber-stamp it.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Azure OpenAI (used only when LLM_PROVIDER=azure-openai) ---------------
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Embeddings (for Stage 2's clustering step) ----------------------------
# Same provider/model/dimension the rest of this app already standardized
# on for embeddings (see services/orchestrator's own VOYAGE_API_KEY) --
# Anthropic has no first-party embedding model, Voyage is Anthropic's own
# recommended partner. Used to embed each QuestionSignature's
# embedding_basis text before clustering.
VOYAGE_API_KEY=your-voyage-api-key

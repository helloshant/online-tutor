# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local-only compose overrides -- e.g. mounting a corporate/antivirus TLS-
# inspection root CA so containers can reach the outside world on networks
# that intercept HTTPS (see README's "Corporate network / TLS interception"
# note). Machine-specific, never something to commit.
docker-compose.override.yml

# typescript
*.tsbuildinfo
next-env.d.ts

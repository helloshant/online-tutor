# --- Supabase ---------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM provider ---------------------------------------------------------
# Which backend powers the tutor chat: "anthropic" (default) or
# "azure-openai". Only the section for whichever provider you choose needs
# real values below.
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) -------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the model used for tutoring Q&A. Defaults to Anthropic's
# current flagship model if unset.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Azure OpenAI (used only when LLM_PROVIDER=azure-openai) ---------------
# Azure Portal -> your Azure OpenAI resource -> Keys and Endpoint.
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# The deployment name you gave the model in Azure AI Foundry (not the base
# model name itself, unless you named the deployment the same thing).
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Razorpay ------------------------------------------------------------
# Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --- Supabase ---------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Orchestration service -------------------------------------------------
# This app never calls an LLM SDK directly -- it delegates prompt
# construction and the LLM call to the separate orchestration service (see
# services/orchestrator). Provider config (Anthropic / Azure OpenAI) lives
# entirely in that service's own env file.
#
# Running via `docker compose up`: leave this as-is, docker-compose.yml
# overrides it to the in-network hostname (http://orchestrator:4000).
# Running the web app directly with `npm run dev` against a locally running
# orchestrator (`npm run dev` inside services/orchestrator): use
# http://localhost:4000.
ORCHESTRATOR_URL=http://orchestrator:4000
# Must match ORCHESTRATOR_SHARED_SECRET in services/orchestrator/.env.local.
ORCHESTRATOR_SHARED_SECRET=

# --- CCAvenue --------------------------------------------------------------
# CCAvenue dashboard -> Business Settings -> API Keys.
CCAVENUE_MERCHANT_ID=your-ccavenue-merchant-id
CCAVENUE_ACCESS_CODE=your-ccavenue-access-code
CCAVENUE_WORKING_KEY=your-ccavenue-working-key
# "test" uses CCAvenue's sandbox (test.ccavenue.com); switch to "production"
# only once you're using live merchant credentials.
CCAVENUE_ENV=test

# --- Supabase ---------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Orchestration service -------------------------------------------------
# This app never calls an LLM SDK directly -- it delegates prompt
# construction and the LLM call to the separate orchestration service (see
# services/orchestrator). Provider config (Anthropic / Azure OpenAI) lives
# entirely in that service's own env file.
#
# Running via `docker compose up`: leave this as-is, docker-compose.yml
# overrides it to the in-network hostname (http://orchestrator:4000).
# Running the web app directly with `npm run dev` against a locally running
# orchestrator (`npm run dev` inside services/orchestrator): use
# http://localhost:4000.
ORCHESTRATOR_URL=http://orchestrator:4000
# Must match ORCHESTRATOR_SHARED_SECRET in services/orchestrator/.env.local.
ORCHESTRATOR_SHARED_SECRET=

# --- Payment service -------------------------------------------------------
# This app never talks to CCAvenue or writes coupon_codes directly -- it
# delegates the actual payment/coupon business logic to the separate
# payment service (see services/payment). CCAvenue credentials live
# entirely in that service's own env file.
#
# Running via `docker compose up`: leave this as-is, docker-compose.yml
# overrides it to the in-network hostname (http://payment:4200). Running the
# web app directly with `npm run dev` against a locally running payment
# service (`npm run dev` inside services/payment): use
# http://localhost:4200.
PAYMENT_URL=http://payment:4200
# Must match PAYMENT_SHARED_SECRET in services/payment/.env.local.
PAYMENT_SHARED_SECRET=

# --- Broadcast service -------------------------------------------------
# This app never resolves who a broadcast reaches or scores a submitted
# test itself -- it delegates both to the separate broadcast service (see
# services/broadcast). Everything else about a broadcast (drafting, listing,
# reading an inbox, submitting feedback) this app does itself, directly
# against Supabase with its own admin client, the same way it already does
# for coupon_codes/answered_questions/topic_summaries.
#
# Running via `docker compose up`: leave this as-is, docker-compose.yml
# overrides it to the in-network hostname (http://broadcast:4300). Running
# the web app directly with `npm run dev` against a locally running
# broadcast service (`npm run dev` inside services/broadcast): use
# http://localhost:4300.
BROADCAST_URL=http://broadcast:4300
# Must match BROADCAST_SHARED_SECRET in services/broadcast/.env.local.
BROADCAST_SHARED_SECRET=

# --- Archetype-miner service -----------------------------------------------
# /admin/archetype-miner only calls this service for the two operations
# that trigger real background LLM work: submitting a pipeline run, and
# mining cross-level archetype families. Everything else on that admin page
# (listing runs, browsing the mined catalogue, resolving the review queue,
# managing curriculum taxonomies) reads/writes the archetype_* tables
# directly against Supabase with this app's own admin client, the same way
# it already does for coupon_codes/answered_questions/chapter_documents.
#
# Running via `docker compose up`: leave this as-is, docker-compose.yml
# overrides it to the in-network hostname (http://archetype-miner:4400).
# Running the web app directly with `npm run dev` against a locally
# running archetype-miner service (`npm run dev` inside
# services/archetype-miner): use http://localhost:4400.
ARCHETYPE_MINER_URL=http://archetype-miner:4400
# Must match ARCHETYPE_MINER_SHARED_SECRET in services/archetype-miner/.env.local.
ARCHETYPE_MINER_SHARED_SECRET=

# --- Document AI OCR utility (/admin/archetype-miner/ocr) ------------------
# A standalone utility page, entirely separate from the archetype-miner
# pipeline/service -- never touches an LLM, just converts an uploaded image
# or PDF to plain text via Google Document AI (chosen for its strong
# Devanagari/Hindi OCR specifically), for an admin to review and paste
# wherever it's needed themselves. Requires a Google Cloud project with the
# Document AI API enabled, billing set up, and a processor created
# (Cloud Console -> Document AI -> Create Processor -> "Document OCR" --
# the general-purpose one works for this; note its Processor ID and the
# region/location you created it in, e.g. "us"), plus a service account
# (IAM & Admin -> Service Accounts -> Create) granted the
# "Document AI API User" role, with a JSON key generated for it.
GOOGLE_DOCUMENT_AI_PROJECT_ID=your-gcp-project-id
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-processor-id
# From the downloaded service account JSON key file's own client_email field.
GOOGLE_DOCUMENT_AI_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# From the same JSON key file's private_key field -- paste it exactly as it
# appears in that file (a single line with literal \n sequences in it, not
# real line breaks); this app converts those back to real newlines itself.
GOOGLE_DOCUMENT_AI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Usage-based pricing -----------------------------------------------
# Platform-wide monthly LLM token allowance for a student with no
# individual override (see supabase/migrations/0037_student_token_usage_limits.sql
# and /admin/users/[id] for per-student overrides). Enforced in
# src/app/api/chat/route.ts before an LLM call is ever made. Optional --
# falls back to 200,000 if unset or not a positive integer.
DEFAULT_MONTHLY_TOKEN_LIMIT=200000
